APP_NAME=ForenSight Initial Demo
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=sqlite:///./forensight_demo.db
STORAGE_DIR=./storage
MAX_UPLOAD_MB=12
DEMO_MODE=false
